clc;
clear;

seed = input('Enter the initial seed as a row vector: ');
taps = input('Enter the tap positions as a row vector: ');
num_bits = input('Enter the number of bits to generate: ');

if all(seed == 0)
    error('The seed cannot be all zeros.');
end

n = length(seed);
state = seed;
pn = zeros(1, num_bits);

for i = 1:num_bits

    pn(i) = state(end);

    feedback = state(taps(1));

    for j = 2:length(taps)
        feedback = xor(feedback, state(taps(j)));
    end

    state = [feedback state(1:n-1)];

end

disp('Generated PN Sequence:');
disp(pn);
